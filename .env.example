# ============================================================
# OpenClaw Voice Agents — Environment Configuration
# Self-Hosted LiveKit on Oracle Cloud ARM64
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every value below
# 3. Point DNS A records to your server's public IP:
#      openclaw.mooo.com          → YOUR_SERVER_IP
#      livekit.openclaw.mooo.com  → YOUR_SERVER_IP
# ============================================================

# Primary domain for the 3D frontend (no protocol, no trailing slash)
DOMAIN=openclaw.mooo.com

# Email used by Caddy/Let's Encrypt for SSL certificate notifications
ACME_EMAIL=appdevwk4@gmail.com

# Public IP of the Oracle Cloud VM (used for WebRTC ICE candidates)
NODE_IP=0.0.0.0

# LiveKit API credentials
# Generate a key pair:  docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=<your_livekit_api_key>
LIVEKIT_API_SECRET=<your_livekit_api_secret>

# Token server port (default 8081, no need to change)
TOKEN_SERVER_PORT=8081
